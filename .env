# MCP Client Configuration
# Use the host IP if running from another docker-compose in the same host
MCP_SERVER_URL=http://192.168.71.129:8081/mcp
# Docker container allow external request 
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
APP_VERSION=1.0.2
# Use "*" to allow any (default).
# ALLOWED_IPS=["*"]
# Accept request from itself to use healthcheck, docker gateway IP, from itself IP to make request as processcontract, i. e. and from external IP to test 
ALLOWED_IPS=["127.0.0.1", "172.23.0.1", "192.168.71.129", "192.168.71.133"]
